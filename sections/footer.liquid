<footer class="footer">
  <div class="wrap">
    <div class="footer-main">
      <div class="footer-brand">
        <img src="{{ 'logo-lockup.png' | asset_url }}" alt="Rare Hub TCG">
        <p><span class="copy-it">{{ section.settings.about }}</span><span class="copy-en">{{ section.settings.about_en }}</span></p>
        <div class="socials" aria-label="Social">
          <a href="https://www.instagram.com/" target="_blank" rel="noreferrer" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zm5 4.6A4.4 4.4 0 1 0 16.4 12 4.4 4.4 0 0 0 12 7.6zm6.3-.9a1 1 0 1 0 1 1 1 1 0 0 0-1-1zM12 9.2A2.8 2.8 0 1 1 9.2 12 2.8 2.8 0 0 1 12 9.2z"/></svg></a>
          <a href="https://www.tiktok.com/" target="_blank" rel="noreferrer" aria-label="TikTok"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M14.5 3c.4 2.4 1.8 4.1 4.2 4.4v2.5a7.2 7.2 0 0 1-4.2-1.3v6.6a5.7 5.7 0 1 1-5.7-5.7c.3 0 .6 0 .9.1v2.7a3 3 0 1 0 2.1 2.9V3z"/></svg></a>
          <a href="https://www.facebook.com/" target="_blank" rel="noreferrer" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M14.2 21v-7.2h2.4l.4-2.8h-2.8V9.2c0-.8.2-1.4 1.4-1.4H17V5.2A18 18 0 0 0 14.8 5C12.4 5 10.8 6.4 10.8 9v2H8.2v2.8h2.6V21z"/></svg></a>
          <a href="https://wa.me/393534262489" target="_blank" rel="noreferrer" aria-label="WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.04 2C6.58 2 2.15 6.4 2.15 11.83c0 1.74.46 3.44 1.34 4.94L2 22l5.39-1.4a10 10 0 0 0 4.65 1.18h.01c5.46 0 9.89-4.4 9.89-9.84C21.94 6.4 17.5 2 12.04 2zm5.76 14.1c-.24.68-1.4 1.3-1.94 1.38-.5.07-1.12.1-1.81-.11-.41-.13-.95-.31-1.64-.61-2.88-1.24-4.76-4.14-4.9-4.33-.14-.19-1.16-1.54-1.16-2.94s.73-2.08 1-2.37c.24-.27.64-.39 1.02-.39.13 0 .24 0 .35.01.31.01.47.03.68.52.24.58.82 2 .89 2.15.07.14.12.32.02.51-.1.19-.14.31-.29.48-.14.17-.3.37-.43.5-.14.13-.29.28-.12.55.17.26.74 1.22 1.59 1.98 1.09.97 2.01 1.27 2.3 1.41.29.14.46.12.63-.07.17-.19.73-.85.92-1.14.19-.29.39-.24.64-.14.26.1 1.64.77 1.92.91.29.14.48.21.55.33.07.12.07.68-.17 1.36z"/></svg></a>
        </div>
      </div>
      <div class="footer-links">
        <div>
          <strong><span class="copy-it">{{ section.settings.explore }}</span><span class="copy-en">{{ section.settings.explore_en }}</span></strong>
          <a href="#venduti"><span class="copy-it">{{ section.settings.bestsellers }}</span><span class="copy-en">{{ section.settings.bestsellers_en }}</span></a>
          <a href="#community"><span class="copy-it">{{ section.settings.tournaments }}</span><span class="copy-en">{{ section.settings.tournaments_en }}</span></a>
          <a href="#scrivici" data-ask="vendi"><span class="copy-it">{{ section.settings.sell }}</span><span class="copy-en">{{ section.settings.sell_en }}</span></a>
        </div>
        <div>
          <strong><span class="copy-it">{{ section.settings.contact }}</span><span class="copy-en">{{ section.settings.contact_en }}</span></strong>
          <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
          <a href="https://wa.me/393534262489" target="_blank" rel="noreferrer">+39 353 426 2489</a>
          <p><span class="copy-it">{{ section.settings.orders }}</span><span class="copy-en">{{ section.settings.orders_en }}</span></p>
          <span><span class="copy-it">{{ section.settings.place }}</span><span class="copy-en">{{ section.settings.place_en }}</span></span>
        </div>
        <div class="footer-news">
          <strong><span class="copy-it">{{ section.settings.news }}</span><span class="copy-en">{{ section.settings.news_en }}</span></strong>
          <p><span class="copy-it">{{ section.settings.news_body }}</span><span class="copy-en">{{ section.settings.news_body_en }}</span></p>
          {% form 'customer', id: 'newsletter' %}
            {% if form.posted_successfully? %}
              <p class="news-ok" data-t="newsOk">Iscrizione registrata. Puoi cancellarla scrivendo a info@rarehubtcg.com.</p>
            {% else %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <input type="email" name="contact[email]" required placeholder="{{ section.settings.email_ph }}" data-ph-it="{{ section.settings.email_ph | escape }}" data-ph-en="{{ section.settings.email_ph_en | escape }}" aria-label="Email per gli aggiornamenti">
              <button type="submit" aria-label="Iscriviti"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
              <label class="news-consent"><input type="checkbox" name="contact[accepts_marketing]" value="true" required> Acconsento a ricevere novità via email, come descritto nella <a href="#/privacy">privacy</a>.</label>
              {% if form.errors %}<p class="pay-note">{{ form.errors | default_errors }}</p>{% endif %}
            {% endif %}
          {% endform %}
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="pay-marks" aria-label="Visa, Mastercard, American Express, Apple Pay, PayPal">
        <img class="pay" src="{{ 'pay-visa.png' | asset_url }}" alt="Visa">
        <img class="pay" src="{{ 'pay-mastercard.png' | asset_url }}" alt="Mastercard">
        <img class="pay" src="{{ 'pay-amex.png' | asset_url }}" alt="American Express">
        <img class="pay" src="{{ 'pay-apple.png' | asset_url }}" alt="Apple Pay">
        <img class="pay" src="{{ 'pay-paypal.png' | asset_url }}" alt="PayPal">
      </div>
      <nav class="footer-legal" aria-label="Note legali">
        <a href="#/privacy">Privacy</a>
        <a href="#/condizioni">Condizioni di vendita</a>
        <a href="#/resi">Resi e recesso</a>
      </nav>
      <span>© {{ 'now' | date: '%Y' }} rarehubtcg.com</span>
      <div class="lang-switch" role="group" aria-label="Lingua"><span><span class="copy-it">{{ section.settings.language }}</span><span class="copy-en">{{ section.settings.language_en }}</span></span><button type="button" data-lang="it" class="is-on" aria-pressed="true">IT</button><button type="button" data-lang="en" aria-pressed="false">EN</button></div>
    </div>
  </div>
</footer>

